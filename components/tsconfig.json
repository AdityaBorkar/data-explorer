{
	"compilerOptions": {
		"declarationDir": "../.local/types/components",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"paths": {
			"@/*": ["./src/*"],
			"@/components/ui/*": ["./src/primitives/*"],
			"@/lib/utils": ["./src/lib/utils.ts"],
			"#/*": ["./src/*"],
			"#/components/ui/*": ["./src/primitives/*"],
			"#/lib/utils": ["./src/lib/utils.ts"]
		},
		"target": "ES2022",
		"types": ["react"]
	},
	"extends": "../tsconfig.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"references": [{ "path": "../package" }]
}
