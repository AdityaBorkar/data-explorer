{
	"workspaces": [
		"./package",
		"./examples",
		"./components"
	],
	"scripts": {
		"analyze:packages": "bun audit",
		"check:lint": "biome check --fix .",
		"check:types": "tsc -b",
		"clean": "bunx rimraf --glob \"**/{node_modules,.output,.local,.tanstack,.wrangler,bun.lockb}\"",
		"format": "biome format --fix .",
		"prepare": "husky",
		"update:deps": "bun taze -rw --maturity-period 3 && bun install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"taze": "21",
		"typescript": "^7.0.2"
	}
}
