{
	"workspaces": [
		"./package",
		"./examples",
		"./components"
	],
	"scripts": {
		"analyze:deps": "bun audit",
		"check:conform": "echo 'Todo'",
		"check:lint": "biome check .",
		"check:types": "tsc -b",
		"clean": "bunx rimraf --glob \"**/{node_modules,.output,.local,.tanstack,.wrangler,bun.lockb}\"",
		"fix:format": "biome format --fix .",
		"fix:lint": "biome check --fix .",
		"prepare": "husky",
		"update-deps": "bun taze -rw --maturity-period 3 && bun install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@changesets/cli": "^3.0.2",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"taze": "21",
		"typescript": "^7.0.2"
	}
}
